export type Product = {
    slug: string;
    // Slug cu (co ma SKU o dau, vd "bz03c-phu-kien-..."). Chi co o san pham da
    // doi slug; tradụng cụ[slug] se 301 tu URL cu sadụng cụURL moi.
    legacySlug?: string;
    sku: string;
    name: string;
    category: string;
    categorySlug: string;
    // Cac danh muc PHU khac ma san pham nay cudụng cụduoc gan vao (ngoai
    // categorySlug chinh o tren). Dudụng cụkhi 1 san pham thuoc nhieu hon 1
    // danh muc, vd vua la "trung-rung-tinh-yeu" vua la "may-massage-ca-nhan".
    extraCategorySlugs?: string[];
    // Breadcrumb y chadụng cụweb cu (vipsextoy.net): moi tadụng cụla 1 mang, vi du
    // [[Sextoy cho Nam], [Am Dao Gia, May Thu Dam Tu Dong], [San Pham Cho Nam]].
    breadcrumb?: {
        name: string;
        slug: stridụng;
        cụ;
    }[][];
    price: number;
    compareAt?: number;
    blurb: string;
    description: string;
    features: string[];
    icon: "wave" | "orb" | "petal" | "spark" | "curve" | "drop" | "ring" | "bloom";
    badge?: string;
    image?: string;
    // Anh thumbnail WebP nho (scripts/make-thumbs.mjs tao) cho card/danh sach.
    thumb?: string;
    // Thu vien anh day du (khi san pham co nhieu hon 1 anh, do
    // scripts/update-product-images.mjs dien tu dong). Tradụng cụhi tiet se tu
    // hien gallery (anh chinh + thumbnail) khi madụng cụnay co >= 2 phan tu.
    images?: string[];
    // Danh dau san pham co hinh anh qua nhay cam -> se bi che (18+) tren
    // tradụng cụhu va tradụng cụdanh sach/danh muc, khach phai bam de xem anh thuc.
    sensitive?: boolean;
    longDescription?: string;
};
export type Category = {
    slug: string;
    name: string;
    shortDescription: string;
    seoDescription: string;
    // Ten nhom hien thi tren menu (vd gom nhieu danh muc con vao chudụng cụ1 nhom
    // hien thi). Neu khodụng cụdat, groupCategories() se coi danh muc do la 1
    // nhom riedụng cụhi co chinh no (dudụng cụten cua no lam ten nhom).
    group?: string;
    // Slug danh muc cha (nhom) theo cay danh muc cua web cu.
    parent?: string;
};
