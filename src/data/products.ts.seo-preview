export function getProduct(slug: string) {
    return products.find((p) => p.slug === slug);
}
// Map tao luc goi lan dau (lazy) - KHONG dat vodụng cụlap o cap module, neu khong
// bundler khodụng cụthe loai madụng cụproducts khoi JS phia trinh duyet.
let legacySlugMap: Map<string, Product> | undefined;
export function getProductByLegacySlug(slug: string) {
    if (!legacySlugMap) {
        legacySlugMap = new Map();
        for (const p of products)
            if (p.legacySlug)
                legacySlugMap.set(p.legacySlug, p);
    }
    return legacySlugMap.get(slug);
}
export function getProductsByCategory(categorySlug: string) {
    return products.filter((p) => p.categorySlug === categorySlug || p.extraCategorySlugs?.includes(categorySlug));
}
export function formatPrice(price: number) {
    return price.toLocaleString("vi-VN") + "đ";
}
