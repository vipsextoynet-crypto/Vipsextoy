    {
        slug: "khoa-silicon-co-rung-giup-mau-cuong-cung-va-chong-xuat-tinh-som",
        legacySlug: "bd10k-khoa-silicon-co-rung-giup-mau-cuong-cung-va-chong-xuat-tinh-som",
