export function getCategory(slug: string) {
    return categories.find((c) => c.slug === slug);
}
/** Gom danh sach categories theo "group" (ten nhom hien thi tren thanh
 *  mau hodụng cụtrodụng cụmenu). Danh muc khodụng cụo group (vd "Nước Hoa") duoc
 *  coi la 1 nhom riedụng cụhi co dudụng cụno. Dudụng cụhudụng cụho Header + Sidebar. */
export function groupCategories(list: Category[]) {
    const order: string[] = [];
    const map = new Map<string, Category[]>();
    for (const c of list) {
        const key = c.group ?? c.name;
        if (!map.has(key)) {
            order.push(key);
            map.set(key, []);
        }
        map.get(key)!.push(c);
    }
    return order.map((group) => ({ group, items: map.get(group)! }));
}
