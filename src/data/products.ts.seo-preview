        slug: "quan-lot-rung-candy-mac-moi-luc-moi-noi-dieu-khien-qua-app-ms32k",
        legacySlug: "ms32k-quan-lot-rung-candy-mac-moi-luc-moi-noi-dieu-khien-qua-app-ms32k",
