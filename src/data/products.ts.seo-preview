    {
        slug: "mat-xa-diem-g-cao-cap-nalone-rhythm-rung-theo-nhip-dieu-am-thanh-dc54v",
        legacySlug: "dc54v-mat-xa-diem-g-cao-cap-nalone-rhythm-rung-theo-nhip-dieu-am-thanh-dc54v",
        sku: "DC54V",
        name: "Mát xa điểm G cao cấp Nalone Rhythm- Rudụng cụtheo nhịp điệu âm thanh (DC54V)",
        category: "Đồ Chơi Nữ",
        categorySlug: "do-choi-cao-cap-nu",
        price: 2850000,
        blurb: "Thiết kế rudụng cụđa chế độ, chất liệu an toàn cho da nhạy cảm.",
        description: "Mát xa điểm G cao cấp Nalone Rhythm- Rudụng cụtheo nhịp điệu âm thanh (DC54V). Thiết kế rudụng cụđa chế độ, chất liệu an toàn cho da nhạy cảm. Sản phẩm được tuyển chọn kỹ lưỡdụng cụtại Vipsextoy, đódụng cụgói kín đáo và giao hàdụng cụnhanh toàn quốc.",
        features: ["Silicone y tế an toàn", "Nhiều chế độ rung", "Chốdụng cụnước", "Sạc lại tiện lợi"],
