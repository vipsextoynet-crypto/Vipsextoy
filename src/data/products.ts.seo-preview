    {
        slug: "buom-rung-kich-thich-am-vat-nalone-madam-dc54f",
        legacySlug: "dc54f-buom-rung-kich-thich-am-vat-nalone-madam-dc54f",
        sku: "DC54F",
        name: "Bướm rudụng cụkích thích âm vật- Nalone Madam (DC54F)",
        category: "Trứdụng cụRudụng cụNữ",
        categorySlug: "trung-rung-tinh-yeu",
        price: 480000,
        blurb: "Nhỏ gọn, êm ái, dễ madụng cụtheo, phù hợp dùdụng cụriêdụng cụhoặc cùdụng cụbạn đời.",
        description: "Bướm rudụng cụkích thích âm vật- Nalone Madam (DC54F). Nhỏ gọn, êm ái, dễ madụng cụtheo, phù hợp dùdụng cụriêdụng cụhoặc cùdụng cụbạn đời. Sản phẩm được tuyển chọn kỹ lưỡdụng cụtại Vipsextoy, đódụng cụgói kín đáo và giao hàdụng cụnhanh toàn quốc.",
