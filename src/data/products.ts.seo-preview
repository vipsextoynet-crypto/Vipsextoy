        slug: "keo-tinh-yeu-phong-the-love-mint-bac-ha-the-mat-tang-khoai-cam-khi-yeu",
        legacySlug: "sl18-keo-tinh-yeu-phong-the-love-mint-bac-ha-the-mat-tang-khoai-cam-khi-yeu",
