    {
        slug: "bo-khuc-don-cac-kieu-de-cac-nang-len-dinh-theo-nhieu-cach-dc10k",
        legacySlug: "dc10k-bo-khuc-don-cac-kieu-de-cac-nang-len-dinh-theo-nhieu-cach-dc10k",
